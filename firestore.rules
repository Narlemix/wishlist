rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/admins/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.key));
    }

    match /admins/{key} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'key', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 20
        && !request.resource.data.name.matches('.*/.*')
        && request.resource.data.key is string
        && !request.resource.data.key.matches('.*/.*')
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.key)).data.uid == uid;
      allow update, delete: if false;
    }

    match /usernames/{key} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.key == key;
      allow update, delete: if false;
    }

    match /reservations/{itemId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }
  }
}
